# ==============================================================================
# CreatorMatch - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local:
#   copy .env.local.example .env.local
# Then fill in the values below.
# ==============================================================================

# 1. SUPABASE CONFIGURATION (Required for Phase 2 - Phase 6)
# ------------------------------------------------------------------------------
# Where to find:
# 1. Sign up / Log in to Supabase (https://supabase.com)
# 2. Open your project dashboard (or create a new project called "creatormatch")
# 3. Click the gear icon (Project Settings) on the bottom left
# 4. Click "API" under Configuration
# 5. Copy "Project URL" and paste below as NEXT_PUBLIC_SUPABASE_URL
# 6. Copy "anon public" Project API key and paste below as NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# (Optional Server-only key: used for administrative tasks if needed)
# Found in Project Settings > API > "service_role" secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here


# 2. AI BRIEF BUILDER LLM KEY (Bonus Feature - Optional)
# ------------------------------------------------------------------------------
# The AI brief builder automatically falls back to smart keyword heuristics from
# index.html if no key is provided!
# If you want real LLM responses (Gemini or OpenAI), provide ONE of the keys below:

# Option A: Google Gemini API Key
# Where to find: Go to https://aistudio.google.com/app/apikey and click "Create API key"
GEMINI_API_KEY=

# Option B: OpenAI API Key
# Where to find: Go to https://platform.openai.com/api-keys and click "Create new secret key"
OPENAI_API_KEY=
